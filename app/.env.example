# ── GitHub Copilot Auth ───────────────────────────────────────────────────────
# Classic PAT with read:user and read:org scopes
# Generate at: https://github.com/settings/tokens (classic)
# Works for Individual, Business, and Enterprise Copilot accounts
GHU_APP_TOKEN=ghu_your_oauth_token_here

# ── Proxy Server ──────────────────────────────────────────────────────────────
# Port to listen on (default: 3100)
PROXY_PORT=3100

# Host/interface to bind to (default: 127.0.0.1 — localhost only).
# Set to 0.0.0.0 when running in a container (e.g. Docker) so the proxy is
# reachable from other containers on the same network. Keep the default of
# 127.0.0.1 for local, non-containerized use.
PROXY_HOST=127.0.0.1

# Your app identifier (used in Copilot telemetry headers)
PROXY_INTEGRATION_ID=standalone-aiproxy

# Directory for persisting metrics and exchange history (default: ./data)
PROXY_STORAGE_DIR=./data

# ── Optional Settings ─────────────────────────────────────────────────────────
# Minimum seconds between requests (0 = no rate limit)
PROXY_RATE_LIMIT_SECONDS=0

# If rate limited, wait instead of returning 429 (true/false)
PROXY_RATE_LIMIT_WAIT=false

# Log every request/response to stdout (true/false)
PROXY_LOG_REQUESTS=false

# Expose raw JWT at GET /token — NEVER enable in production (true/false)
PROXY_SHOW_TOKEN=false

# ── Backend selection (Phase 2/3) ────────────────────────────────────────────
# copilot | openai | anthropic | ollama | azure-openai | aws-bedrock
# Can also be switched at runtime via GET /admin (persisted to PROXY_STORAGE_DIR/backend-override.json).
LLM_BACKEND=copilot

# Override base URL for openai/anthropic/ollama backends (optional — auto-resolved if unset)
LLM_BASE_URL=

# API key for openai/anthropic backends
LLM_API_KEY=

# ── Azure AI Foundry (azure-openai backend) ──────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-01

# ── AWS Bedrock (aws-bedrock backend) ────────────────────────────────────────
# Auth resolved via the AWS SDK default credential chain (env vars/profile/role) — see docs/PLAN.md Step 10.
AWS_REGION=ap-southeast-2
AWS_BEDROCK_MODEL_ID=

